{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Orchestra research",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "family",
    "vendor",
    "channel",
    "tier",
    "supersedes",
    "caps",
    "speed_rank_hint",
    "quota_rank_hint",
    "notable_strengths",
    "notable_weaknesses",
    "suggested_hard_rules",
    "sources_checked"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["codex", "agy"]
    },
    "tier": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_rigor",
        "backend",
        "math",
        "image_gen",
        "frontend_aesthetic",
        "prose",
        "world_knowledge",
        "long_context",
        "agentic_coding",
        "office_docs"
      ],
      "properties": {
        "code_rigor": { "$ref": "#/definitions/capability" },
        "backend": { "$ref": "#/definitions/capability" },
        "math": { "$ref": "#/definitions/capability" },
        "image_gen": { "$ref": "#/definitions/capability" },
        "frontend_aesthetic": { "$ref": "#/definitions/capability" },
        "prose": { "$ref": "#/definitions/capability" },
        "world_knowledge": { "$ref": "#/definitions/capability" },
        "long_context": { "$ref": "#/definitions/capability" },
        "agentic_coding": { "$ref": "#/definitions/capability" },
        "office_docs": { "$ref": "#/definitions/capability" }
      }
    },
    "speed_rank_hint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "quota_rank_hint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "notable_strengths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notable_weaknesses": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "suggested_hard_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "locked": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "sources_checked": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string", "format": "uri" },
          {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "claim": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "format": "date" }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "claim", "date"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "vs_incumbent", "confidence", "evidence"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "vs_incumbent": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" }
        }
      }
    }
  }
}
