    {
      "id": "frontend-aesthetic-gate",
      "when_tags_any": ["frontend", "ui", "landing_page"],
      "pattern": "aesthetic_gate",
      "reviewer": "best-aesthetic",
      "reviewer_fallback": "gemini-4-carbon",
      "exclude_reviewer_from_primary": true,
      "locked": true,
      "note": "Opus 只审截图/diff 与 design tokens，不写长代码；Opus 不可用时由 Gemini 4 Carbon 按设计检查清单审"
    },
    {
      "id": "rigor-review",
      "when_tags_any": ["backend", "api", "concurrency", "math", "algorithm"],
      "reviewer": "best-rigor",
      "locked": false,
      "note": "数学/后端正确性审查交给最严谨的模型；若它本身就是 primary，则改由次优且不同厂商的模型审查"
    },
    {
      "id": "final-prose-polish",
      "when_tags_any": ["prose", "essay", "paper", "copywriting", "landing_page"],
      "polisher": "best-prose",
      "locked": true,
      "note": "最终文字润色交给文笔最好的模型（Gemini 4 Carbon）；拒绝防御性写作"
    }
