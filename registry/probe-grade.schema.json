{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Orchestra blind probe evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parts",
    "fatal_cap_triggered",
    "rationale"
  ],
  "properties": {
    "parts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      }
    },
    "fatal_cap_triggered": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
